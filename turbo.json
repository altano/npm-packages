{
  "$schema": "./node_modules/turbo/schema.json",
  "globalEnv": ["CI", "DEBUG", "NODE_ENV"],
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "build": {
      "outputs": ["dist/**", ".next/**"],
      "dependsOn": ["^build"]
    },
    "build:documentation": {
      "dependsOn": [
        "build:documentation:custom-elements-json",
        "build:documentation:readme"
      ]
    },
    "build:documentation:custom-elements-json": {
      "outputs": ["dist/custom-elements.json"],
      "dependsOn": ["build"]
    },
    "build:documentation:readme": {
      "outputs": ["README.md"],
      "dependsOn": ["build"]
    },
    "check": {
      "dependsOn": [
        "//#check:dependencies",
        "//#check:dependency-resolution",
        "check:exports",
        "check:types",
        "check:unused-dependencies"
      ]
    },
    "check:exports": {
      "dependsOn": ["build"]
    },
    "check:types": {
      "dependsOn": ["check:types:astro", "check:types:src", "check:types:test"]
    },

    "check:types:astro": {
      "dependsOn": ["build"] // script uses other packages
    },
    "check:types:test": {
      "dependsOn": ["build"]
    },
    "check:types:src": {
      "dependsOn": ["build"]
    },
    "check:unused-dependencies": {
      "dependsOn": []
    },
    "format": {
      // packages/*/.prettierignore is a symlink to the root file, so its git
      // blob is just the target path -- editing the root file changes no
      // package input. These root globs are what actually invalidate the cache.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.editorconfig",
        "$TURBO_ROOT$/.prettierignore",
        "$TURBO_ROOT$/.prettierrc.json"
      ]
    },
    "test": {
      "dependsOn": ["test:unit", "test:e2e"]
    },
    "test:unit": {
      "outputs": [".coverage/**"],
      "dependsOn": ["build"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "env": ["PLAYWRIGHT_*"]
    },
    "lint": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": ["build"]
    },
    "//#lint": {},
    "//#check:dependencies": {},
    "//#check:dependencies:fix": {},
    "//#check:dependency-resolution": {},
    "dev": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
