{
  "name": "@altano/testing",
  "version": "0.0.1",
  "private": true,
  "description": "Test configuration files shared across the repo",
  "license": "ISC",
  "type": "module",
  "exports": {
    "./playwright": "./dist/playwright/index.js",
    "./vitest": "./dist/vitest/index.js",
    "./vitest/setup": "./dist/vitest/setup.js",
    "./vitest/setup-dom": "./dist/vitest/setup-dom.js",
    "./vitest/types": "./dist/vitest/types.js",
    "./vitest/types-dom": "./dist/vitest/types-dom.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "check:exports": "attw --pack . --profile esm-only --quiet",
    "check:types:src": "tsc --noEmit",
    "check:unused-dependencies": "depcheck",
    "clean": "rm -rf .turbo && rm -rf .tsbuildinfo && rm -rf node_modules && rm -rf dist",
    "dev": "pnpm run build --watch",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint",
    "lint:fix": "TIMING=1 pnpm lint --fix",
    "lint:timing": "TIMING=1 pnpm lint"
  },
  "dependencies": {
    "@altano/vitest-plugins": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@altano/build-config": "workspace:*",
    "@altano/tsconfig": "workspace:*",
    "@arethetypeswrong/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "depcheck": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@playwright/test": "1.x.x",
    "@vitest/coverage-v8": "4.x.x",
    "vitest": "4.x.x"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
